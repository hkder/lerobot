# Edit these for the machine the arms are plugged into. Find ports with: ~/so101/so101.sh ports
SO101_FOLLOWER=/dev/tty.usbmodem5B790177611
SO101_LEADER=/dev/tty.usbmodem5B790160051
SO101_WRIST_CAM=0
SO101_TOP_CAM=1
# Optional. Windows needs MJPG + DirectShow (700) for 30 fps at 720p; leave empty on macOS.
SO101_CAM_FOURCC=
SO101_CAM_BACKEND=
